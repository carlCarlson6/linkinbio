{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2021",                        /* Modern JavaScript output */
    "lib": ["ES2021"],                         /* Built-in library declarations */
    "module": "CommonJS",                      /* Node.js runtime */
    "moduleResolution": "Node",                /* Resolve Node-style imports */
    "types": ["node"],                         /* Include Node.js type definitions */

    /* Paths and Resolution */
    "baseUrl": "./src",                        /* Root folder for module resolution */
    "rootDirs": ["./src"],                     /* Helps with debugging mapped modules */
    "outDir": "./dist",                        /* Where compiled JS goes */
    "esModuleInterop": true,                   /* Enable interop between CJS and ESM */
    "resolveJsonModule": true,                 /* Allow importing .json files */
    "allowSyntheticDefaultImports": true,      /* Support default imports from CJS modules */
    "skipLibCheck": true,                      /* Skip type checking of declaration files */

    /* Type Checking */
    "strict": true,                            /* Enable all strict type checks */
    "noImplicitAny": true,                     /* Prevent `any` without explicit type */
    "strictNullChecks": true,                  /* Null and undefined handling */
    "noUnusedLocals": true,                    /* Error on unused local variables */
    "noUnusedParameters": true,                /* Error on unused function params */
    "noFallthroughCasesInSwitch": true,        /* Ensure switch cases are explicit */
    "forceConsistentCasingInFileNames": true,  /* Disallow inconsistent imports */

    /* Source Maps */
    "sourceMap": true,                         /* Enable source maps for debugging */
    "inlineSources": true,                     /* Embed source in maps */
    "removeComments": true                     /* Clean build output */
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
